# ============================================================
# OB1 RADAR GLOBAL - Environment Variables
# ============================================================
#   cp .env.example .env
# ============================================================

# === LLM: ZERO-COST FIRST ===
#
# La v2 prova i provider GRATUITI prima di Gemini. Con il billing attivo sul
# progetto Google, Gemini oltre il free tier FATTURA: chiamandolo per ultimo
# (free_first) o mai (free_only) il costo resta zero per costruzione.
#
#   free_first    catena gratuita -> Gemini solo se falliscono tutti  [default]
#   free_only     Gemini mai chiamato, costo zero garantito
#   gemini_first  comportamento storico (sconsigliato con billing attivo)
OB1_LLM_MODE=free_first

# Groq — consigliato, free tier senza carta (https://console.groq.com)
GROQ_API_KEY=

# Opzionali, stessa catena in quest'ordine (più chiavi = più quota gratuita)
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Tetto caratteri inviati ai provider gratuiti (token/minuto dei free tier)
FREE_MAX_CHARS=2800

# Google Gemini — SOLO free tier (https://aistudio.google.com/apikey)
# Verifica che il billing sia SPENTO sul progetto della chiave, o si paga.
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# === PIPELINE ===

# Max chiamate LLM per run (v2)
INGEST_LLM_BUDGET=15
# Pausa tra chiamate, secondi: tiene sotto il token/minuto dei free tier
INGEST_CALL_DELAY=12

# Serper - optional, used by enricher (Transfermarkt check) and mainstream detection
# https://serper.dev — free tier: 2500 req/month
SERPER_API_KEY=

# === TELEGRAM ===

# Bot token (da @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat ID gruppo K-Sport — notifiche nuovi talenti
TELEGRAM_CHAT_ID=

# Chat ID personale Mirko — admin_alert (errori pipeline, solo tu)
TELEGRAM_OFFICE_CHAT_ID=

# === DEBUG ===

OB1_DEBUG=false
OB1_TEST=false
