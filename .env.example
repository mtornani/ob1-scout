# ============================================================
# OB1 RADAR - Environment Variables
# ============================================================
# Copia questo file come .env e inserisci le tue API keys.
#   cp .env.example .env
# ============================================================

# === REQUIRED ===

# Serper.dev - Web search API (https://serper.dev)
# Piano free: ~2500 ricerche/mese
SERPER_API_KEY=your_serper_key_here

# Google Gemini - AI model (https://aistudio.google.com/apikey)
# Usato da: v0.9.0 cognitive scoring, ob1_market_hunter, Serie C agent
GEMINI_API_KEY=your_gemini_key_here

# === OPTIONAL ===

# AnyCrawl - Web scraping API (https://anycrawl.dev)
# Fallback per scraping quando i siti bloccano le richieste dirette
ANYCRAWL_API_KEY=

# Brave Search - Alternative search API (https://brave.com/search/api/)
# Non usato attivamente nella v0.8.2, disponibile come fallback
BRAVE_API_KEY=

# === DEBUG ===

# Attiva modalita' debug (verbose logging)
OB1_DEBUG=false

# Attiva modalita' test (limita il numero di query)
OB1_TEST=false

# === OB1 SERIE C (sub-progetto) ===

# Telegram Bot Token (da @BotFather)
# Richiesto solo se usi il bot Telegram di Serie C
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ID utenti Telegram autorizzati (separati da virgola)
ALLOWED_TELEGRAM_USERS=

# ID chat Telegram per notifiche utenti (team K-Sport)
TELEGRAM_CHAT_IDS=

# ID chat admin privato Mirko — destinazione admin_alert (canale interno)
TELEGRAM_OFFICE_CHAT_ID=

# URL GitHub Pages per dashboard (opzionale)
GITHUB_PAGES_URL=

# Livello di log per Serie C (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
