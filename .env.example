# ============================================================
# OB1 RADAR GLOBAL - Environment Variables
# ============================================================
#   cp .env.example .env
# ============================================================

# === REQUIRED ===

# Google Gemini - AI model (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_key_here

# Serper - optional, used by enricher (Transfermarkt check) and mainstream detection
# https://serper.dev — free tier: 2500 req/month
SERPER_API_KEY=

# === TELEGRAM ===

# Bot token (da @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat ID gruppo K-Sport — notifiche nuovi talenti
TELEGRAM_CHAT_ID=

# Chat ID personale Mirko — admin_alert (errori pipeline, solo tu)
TELEGRAM_OFFICE_CHAT_ID=

# === DEBUG ===

OB1_DEBUG=false
OB1_TEST=false
